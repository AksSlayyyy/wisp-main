FROM node:22-bookworm-slim

RUN rm -rf /var/lib/apt/lists/* \
  && apt-get update -o Acquire::Retries=3 \
  && apt-get install -y --no-install-recommends --fix-missing python3 chromium fonts-liberation \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY . .

ENV NODE_ENV=production \
  WISP_MERGE_HOST=0.0.0.0 \
  WISP_CHROME_PATH=/usr/bin/chromium \
  WISP_PYTHON_PATH=/usr/bin/python3

EXPOSE 10000

CMD ["node", "scripts/wisp_merge_service.mjs"]
